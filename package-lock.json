{
  "name": "smart-home-mvp",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "smart-home-mvp",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/backend": {
      "name": "@smart-home/backend",
      "version": "0.1.0",
      "dependencies": {
        "@smart-home/shared": "0.1.0"
      }
    },
    "apps/frontend": {
      "name": "@smart-home/frontend",
      "version": "0.1.0",
      "dependencies": {
        "@smart-home/shared": "0.1.0"
      }
    },
    "node_modules/@smart-home/backend": {
      "resolved": "apps/backend",
      "link": true
    },
    "node_modules/@smart-home/frontend": {
      "resolved": "apps/frontend",
      "link": true
    },
    "node_modules/@smart-home/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@smart-home/shared",
      "version": "0.1.0"
    }
  }
}
